# === CẤU HÌNH BẮT BUỘC ===
# ID Google Sheet chính (chứa Đăng kí, CSDL_NhanSu, Log_ThuocNHT...)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ID Google Sheet Vật tư (nếu dùng module Vật tư)
GOOGLE_SHEET_ID_VATTU=your_vattu_sheet_id_here

# Port server (mặc định 3000)
PORT=3000

# === FILE CREDENTIAL GOOGLE ===
# Copy file service-account.json vào thư mục credentials/
# Tải từ: Google Cloud Console > APIs & Services > Credentials > Service Account > Keys

# === CẤU HÌNH TÙY CHỌN ===
# Zalo Bot (nếu dùng)
ZALO_ACTIVE=false
ZALO_TOKEN=
ZALO_API_URL=https://bot-api.zapps.me/bot

# Email thông báo (nếu dùng)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_PASS=
